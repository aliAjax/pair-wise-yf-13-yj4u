{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 62001",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 62001",
    "typecheck": "tsc --noEmit",
    "verify:domain": "esbuild verify/check.ts --bundle --platform=node --format=esm --outfile=.tmp/check.mjs --external:jsdom --log-level=warning && node .tmp/check.mjs",
    "verify:smoke": "esbuild verify/smoke.tsx --bundle --platform=node --format=esm --outfile=.tmp/smoke.mjs --external:jsdom --log-level=warning && node .tmp/smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1"
  }
}
